# ── Заявки ──────────────────────────────────────────────
# Telegram: бот від @BotFather, додай його в чат оргів.
# chat_id групи виглядає як -100xxxxxxxxxx (відкрий https://api.telegram.org/bot<TOKEN>/getUpdates
# після будь-якого повідомлення в чаті).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необов'язково: id теми, якщо чат з топіками
TELEGRAM_THREAD_ID=

# Google Sheets: URL веб-застосунку Apps Script (…/exec) і той самий SECRET, що в Script properties.
# Потрібно і для прийому заявок, і для розділу «Заявки» в адмінці.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# ── Адмінка (/admin) ────────────────────────────────────
# Пароль входу, мінімум 8 символів. Змінив пароль — усі сесії розлогінились.
ADMIN_PASSWORD=
# Необов'язково: додаткова сіль для підпису сесій
ADMIN_SESSION_SECRET=

# GitHub: адмінка зберігає зміни комітами в репо, Vercel після коміту сам перезбирає сайт.
# Fine-grained token → Only select repositories → цей репо → Permissions: Contents = Read and write.
GITHUB_TOKEN=
# owner/repo, напр. venzyyyk/khnue-cyber. На Render задавати обовʼязково.
# (На Vercel можна не задавати — візьметься з VERCEL_GIT_REPO_OWNER/SLUG.)
GITHUB_REPO=
# Гілка, з якої деплоїться прод. За замовчуванням main.
GITHUB_BRANCH=

# Де що працює:
#   - Локально `npm run dev` без GITHUB_TOKEN — адмінка пише прямо у файли проєкту (для тесту).
#   - На хостингу (Render / Vercel) файлова система тимчасова, тому там адмінка ЗАВЖДИ через GitHub:
#     задавай GITHUB_TOKEN + GITHUB_REPO, інакше розділи редагування будуть вимкнені.
